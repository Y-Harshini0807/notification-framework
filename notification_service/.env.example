# MongoDB (API + worker + dlq)
MONGO_URL=mongodb://localhost:27017

# RabbitMQ / Celery (optional locally if not using docker-compose worker)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# Public URL of this API (media links, attachment refresh). No trailing slash.
PUBLIC_BASE_URL=http://localhost:8000

# Media uploads & signed URLs (aligns with Centralized Comms Lib flow)
MEDIA_DIR=
MEDIA_TOKEN_SECRET=
MEDIA_URL_TTL_DAYS=30
MEDIA_UPLOAD_MAX_MB=250
ALLOW_PRIVATE_MEDIA_URLS=0
ALLOWED_PRIVATE_MEDIA_HOSTS=

# Email — SendGrid (primary)
SENDGRID_API_KEY=
SENDGRID_FROM=noreply@example.com
EMAIL_MAX_ATTACHMENT_MB=20

# Email — SMTP fallback (optional)
SMTP_EMAIL=
SMTP_PASSWORD=

# SMS — SendFire
SENDFIRE_API_KEY=
SENDFIRE_SENDER_ID=NOTIFY

# WhatsApp — UltraMsg
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
ULTRAMSG_SEND_MEDIA=1
WHATSAPP_MAX_MEDIA_MB=64

# Push — Firebase Cloud Messaging HTTP v1
# Use a Firebase service account with the Firebase Cloud Messaging API enabled.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=

# Webhooks (optional)
SENDGRID_WEBHOOK_KEY=
ULTRAMSG_WEBHOOK_TOKEN=

# Queue failover tuning (optional)
QUEUE_FAILOVER_ENABLED=1
PRIMARY_QUEUE_CONGESTION_DEPTH=100
PRIMARY_QUEUE_MAX_BUFFER=500
PRIMARY_QUEUE_RECOVER_DEPTH=50
PRIMARY_QUEUE_STUCK_SECONDS=60
QUEUE_FAILOVER_MONITOR_INTERVAL_SEC=5
QUEUE_FAILOVER_MIN_SWITCH_SECONDS=30

PROVIDER_CAP_EMAIL_JOBS_PER_SEC=100
PROVIDER_CAP_SMS_JOBS_PER_SEC=20
PROVIDER_CAP_WHATSAPP_JOBS_PER_SEC=10
PROVIDER_CAP_PUSH_JOBS_PER_SEC=200
